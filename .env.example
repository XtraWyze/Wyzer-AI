WYZER_LLM_PROVIDER=none
WYZER_LLM_MODEL=
WYZER_LLM_ENDPOINT=
WYZER_LLM_API_KEY=
WYZER_LLM_TEMPERATURE=0.1
WYZER_LLM_TIMEOUT_SECONDS=60
WYZER_LLM_KEEP_ALIVE=30m
WYZER_LLM_THINK=false
WYZER_MAX_TOOL_ROUNDS=6
WYZER_CONFIRMATION_TTL_SECONDS=120
WYZER_TOOL_RESULT_CONTEXT_CHARACTERS=4000
WYZER_AUDIO_MASTER_STEP=10
WYZER_AUDIO_APPLICATION_STEP=10
WYZER_TOOL_WORKER_COUNT=2
WYZER_TOOL_TIMEOUT_SECONDS=15
WYZER_EVENT_LEDGER_SIZE=500
WYZER_MEMORY_ENABLED=true
WYZER_ASSISTANT_NAME=Wyzer

# Comma-separated installed tool packs to load, for example: clipboard,home_assistant
WYZER_TOOL_PACKS=

# On-demand local screen perception (uses the configured Ollama model)
WYZER_PERCEPTION_ENABLED=true
WYZER_PERCEPTION_MAX_IMAGE_DIMENSION=1600
WYZER_PERCEPTION_VISION_TIMEOUT_SECONDS=45
WYZER_PERCEPTION_VISUAL_CLICK_MIN_CONFIDENCE=0.70
